# --- Google Drive (one of the two) ---
# Service account key (raw JSON or base64). Share the Drive "events" folder with its client_email as Viewer.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Or an API key - only works if the folder is shared "Anyone with the link".
GOOGLE_API_KEY=
# Optional, defaults to the "events" folder
DRIVE_ROOT_FOLDER_ID=1z1LJJCZUkLvmkj-Rg001URbcc7Om9-sU

# --- Redis (Upstash via Vercel Marketplace sets these automatically) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Protects /api/cron/sync and /api/revalidate. Any long random string. ---
CRON_SECRET=
# Used by `npm run sync` to refresh the deployed site after syncing locally
SITE_URL=https://your-site.vercel.app

# --- Optional: copy every video to Vercel Blob for a native, cookie-free player ---
# Created automatically when you connect a Blob store to the Vercel project. Set MIRROR_TO_BLOB=0 to turn off.
BLOB_READ_WRITE_TOKEN=
